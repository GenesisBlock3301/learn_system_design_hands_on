# Example environment file
# Copy this to .env and fill in your values

# Docker image configuration
IMAGE_NAME=yourusername/infra-practice-app
TAG=latest

# Local port mapping
PORT=8000

# Application configuration (used by main.py)
SERVICE_NAME=infra-practice-app
VERSION=1.0.0
APP_ENV=development
LOG_LEVEL=info

# Secrets (load via ConfigMap/Secret in Kubernetes, never commit real values)
API_KEY=your-secret-api-key-here
